{
  "name": "PROJECT_NAME",
  "description": "Agent for PROJECT_NAME. DESCRIBE_WHAT_THIS_AGENT_DOES.",
  "prompt": "file://./prompts/PROJECT_NAME-prompt.md",
  "tools": ["*"],
  "allowedTools": ["*"],
  "toolsSettings": {
    "shell": {
      "deniedCommands": [
        "rm -rf /.*",
        "git push --force.*",
        "git reset --hard.*",
        "shutdown.*",
        "reboot.*"
      ],
      "autoAllowReadonly": true
    },
    "write": {
      "deniedPaths": ["~/.ssh", "~/.config/gh/hosts.yml", "~/.aws"]
    },
    "subagent": {
      "availableAgents": ["worker", "reviewer", "researcher", "planner"],
      "trustedAgents": ["reviewer", "researcher"]
    }
  },
  "resources": [
    "file://AGENTS.md",
    "file://REPLACE_WITH_HOME/.kiro/steering/**/*.md",
    "file://.kiro/steering/**/*.md",
    "file://.kiro/memory/INDEX.md",
    "skill://~/.kiro/skills/**/SKILL.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "echo \"Dir: $(pwd) | Branch: $(git branch --show-current 2>/dev/null || echo N/A)\""
      }
    ]
  },
  "model": "claude-opus-5",
  "includeMcpJson": true
}
